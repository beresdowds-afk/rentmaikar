# -------------------------------------------------------------
# Rentmaikar Platform Environment Variables & Secrets Reference
# Updated: 2026-08-28 — regenerated from actual edge-function usage.
# Legend:  [SET] already stored   [MISSING] not stored yet   [OPT] optional
# -------------------------------------------------------------

# Client-Side Public Variables (Vite)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=
VITE_API_BASE_URL=          # https://staging.rentmaikar.com (canonical backend API base URL)
VITE_APP_VERSION=

# -------------------------------------------------------------
# Backend & Edge Function Secrets
# -------------------------------------------------------------

# 1. Communications — SMS, Voice & WhatsApp (USA - Twilio)
TWILIO_ACCOUNT_SID=              # [SET]
TWILIO_AUTH_TOKEN=               # [SET]
TWILIO_PHONE_NUMBER=             # [SET]
TWILIO_WHATSAPP_NUMBER=          # [SET]
TWILIO_MESSAGING_SERVICE_SID=    # [SET]
TWILIO_API_KEY_SID=              # [SET]
TWILIO_API_KEY_SECRET=           # [SET]
TWILIO_TWIML_APP_SID=            # [SET]
TWILIO_A2P_BRAND_SID=            # [SET]
TWILIO_A2P_CAMPAIGN_SID=         # [SET]
TWILIO_CUSTOMER_PROFILE_SID=     # [SET]
TWILIO_WHATSAPP_FROM=            # [OPT] falls back to whatsapp:<TWILIO_PHONE_NUMBER>
TWILIO_VOICE_FROM=               # [OPT] falls back to TWILIO_PHONE_NUMBER
TWILIO_MS_USA=                   # [OPT] per-region messaging service override
TWILIO_MS_NG=                    # [OPT] per-region messaging service override
TWILIO_PHONE_NUMBER_NG=          # [OPT] Nigerian long code, if provisioned

# 2. Communications — SMS, OTP & Voice (Nigeria - Termii)
TERMII_API_KEY=                  # [SET]
TERMII_SENDER_ID=                # [SET]
TERMII_WEBHOOK_SECRET=           # [SET]
SENT_WEBHOOK_SECRET=             # [SET]  verifies inbound Sent.dm delivery/status callbacks

# 3. Transactional Email (Resend)
RESEND_API_KEY=                  # [SET] connector-managed
RESEND_FALLBACK_FROM=            # [SET] mail.rentmaikar.com sender until notify NS delegates
RESEND_WEBHOOK_SECRET=           # [MISSING] needed to verify Resend delivery webhooks

# 4. Payment Gateways — PayPal (USA)
PAYPAL_CLIENT_ID=                # [SET]
PAYPAL_CLIENT_SECRET=            # [SET]
PAYPAL_MODE=                     # [SET] sandbox | live
PAYPAL_WEBHOOK_ID=               # [MISSING] required to verify PayPal IPN signatures

# 5. Payment Gateways — Paystack (Nigeria)
PAYSTACK_SECRET_KEY=             # [MISSING] blocks all NGN checkouts
PAYSTACK_PUBLIC_KEY=             # [MISSING] publishable, safe in client config
PAYSTACK_WEBHOOK_SECRET=         # [OPT] Paystack signs with the secret key by default

# 6. Payment Gateways — OPay (Nigeria)  — also settable from /admin/payment-settings
OPAY_MERCHANT_ID=                # [MISSING]
OPAY_PUBLIC_KEY=                 # [MISSING]
OPAY_SECRET_KEY=                 # [MISSING]
OPAY_ENVIRONMENT=                # [MISSING] sandbox | live

# 7. Identity Verification & KYC (Persona)
PERSONA_API_KEY=                 # [SET]
PERSONA_ENVIRONMENT_ID=          # [SET]
PERSONA_MASTER_TEMPLATE_ID=      # [SET]
PERSONA_WEBHOOK_SECRET=          # [SET]
PERSONA_TEMPLATE_ID_US=          # [OPT] DB template rules override this
PERSONA_TEMPLATE_ID_NG=          # [OPT] DB template rules override this

# 8. IoT / Cellular Connectivity (Hologram)
HOLOGRAM_API_KEY=                # [SET]
HOLOGRAM_ORG_ID=                 # [SET]

# 9. Telemetry & MQTT Broker (EMQX)
EMQX_API_URL=                    # [SET]
EMQX_API_KEY=                    # [SET]
EMQX_API_SECRET=                 # [SET]
EMQX_MQTT_HOST=                  # [OPT] admin-configurable in platform_kv_settings
EMQX_MQTT_PORT=                  # [OPT] admin-configurable in platform_kv_settings
MQTT_JWT_SECRET=                 # [SET]

# 10. Telemetry & GPS (Traccar)
TRACCAR_BASE_URL=                # [SET]
TRACCAR_API_TOKEN=               # [SET] primary auth
TRACCAR_EMAIL=                   # [SET] basic-auth fallback
TRACCAR_PASSWORD=                # [SET] basic-auth fallback

# 11. Telemetry & GPS (GPSANDTRACK / SareKon)
SAREKON_USER_ID=                 # [SET] (alias: SAREKON_USERNAME)
SAREKON_PASSWORD=                # [SET]
SAREKON_BASE_URL=                # [OPT] defaults to https://api.sarekon.com/v1

# 12. AI Audio & Narration (ElevenLabs)
ELEVEN_LABS_API_KEY=             # [SET] (code also accepts ELEVENLABS_API_KEY)
ELEVENLABS_AGENT_ID=             # [MISSING] required for the conversational voice agent

# 13. Marketing & Social (Meta / WhatsApp Cloud)
META_PIXEL_ID=                   # [MISSING] Conversions API
META_CAPI_ACCESS_TOKEN=          # [MISSING] Conversions API
META_TEST_EVENT_CODE=            # [OPT] debugging only
META_WEBHOOK_VERIFY_TOKEN=       # [MISSING] Meta webhook subscription
WA_VERIFY_TOKEN=                 # [OPT] WhatsApp Cloud webhook verification
WHATCHIMP_API_KEY=               # [OPT] only if the WhatChimp WA route is enabled
WHATCHIMP_API_BASE=              # [OPT]
WHATCHIMP_PHONE_NUMBER_ID=       # [OPT]
WHATCHIMP_VERIFY_TOKEN=          # [OPT]
WHATCHIMP_WEBHOOK_SECRET=        # [OPT]
MANYCHAT_API_TOKEN=              # [OPT] only if ManyChat automation is enabled
MANYCHAT_WEBHOOK_SECRET=         # [OPT]

# 14. Push Notifications
VAPID_PUBLIC_KEY=                # [SET]
VAPID_PRIVATE_KEY=               # [SET]
VAPID_SUBJECT=                   # [SET]
FCM_SERVER_KEY=                  # [OPT] native Android push only

# 15. System & Internal
CRON_SECRET=                     # [SET]
PROVIDER_SESSION_KEY=            # [SET]
SENT_WEBHOOK_URL=https://staging.rentmaikar.com/api/webhooks/sent  # [SET] Sent.dm delivery/status callback URL
SENT_STATUS_WEBHOOK_URL=https://staging.rentmaikar.com/api/webhooks/sent/status  # [OPTIONAL] Separate Sent.dm delivery-status callback URL
PUBLIC_APP_URL=                  # [MISSING] canonical frontend https://www.rentmaikar.com for links in emails/SMS
PUBLIC_BACKEND_URL=              # [OPT] canonical backend API host, defaults to https://staging.rentmaikar.com
ALLOWED_ORIGINS=                 # [OPT] CORS allowlist, defaults to https://rentmaikar.com,https://www.rentmaikar.com
LOVABLE_API_KEY=                 # [SET] managed
# SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY are injected automatically.

# ─── Sent.dm (default global CPaaS: SMS / WhatsApp / RCS) ───────────────
# Sent is tried FIRST for every outbound message; Twilio (USA) and Termii
# (Nigeria) remain automatic regional fallbacks.
SENT_API_KEY=            # [SET] sent as the `x-api-key` request header
SENT_SENDER_ID=RENTMAIKAR # [SET] approved alphanumeric sender ID
SENT_API_BASE_URL=https://api.sent.dm  # [OPT] override only for staging
SENT_SANDBOX_MODE=false  # [OPT] "true" routes to Sent sandbox
SENT_ENABLED=true        # [OPT] "false" disables Sent and forces Twilio/Termii
SENT_CHANNELS=sms,whatsapp,rcs  # [OPT] channels Sent may serve
SENT_WHATSAPP_NUMBER=+16085489220  # [SET] 10DLC / WhatsApp business sender
SENT_SMS_NUMBER=+16085489220       # [OPT] numeric SMS sender for +1 destinations
                                   # (US carriers reject alphanumeric sender IDs)

# Twilio is approved for VoIP VOICE ONLY — SMS/WhatsApp messaging is NOT
# approved. All messaging routes via Sent.dm (Termii for Nigeria). Leave this
# false unless/until Twilio messaging approval is granted.
TWILIO_MESSAGING_ENABLED=false     # [SET] hard gate on every Twilio Messages API call

